# Virtual environment
venv/

# Python
__pycache__/
*.pyc

# Ultralytics training/inference outputs
# Exception: keep the deployed custom safety-equipment weights (used as default model in detect_webcam.py)
runs/*
!runs/train
runs/train/*
!runs/train/safety_equipment-2
runs/train/safety_equipment-2/*
!runs/train/safety_equipment-2/weights
runs/train/safety_equipment-2/weights/*
!runs/train/safety_equipment-2/weights/best.pt

# Raw dataset images (keep folder structure via .gitkeep)
datasets/raw_images/*.jpg
datasets/raw_images/*.png
!datasets/raw_images/.gitkeep

# Raw source videos (large, contains identifiable footage of participants)
datasets/raw_videos/

# Ultralytics label cache (regenerated automatically, machine-specific)
*.cache

# Stray weight files downloaded by ultralytics checks (not part of this project)
/yolo26n.pt

# OS / editor
.vscode/
.DS_Store
